{
  "expo": {
    "name": "Egypt Museum Experience",
    "slug": "egypt-museum-experience",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "egyptmuseum",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1917"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },

    "plugins": ["expo-router"],
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "name": "Egypt Museum Experience",
      "shortName": "Egypt Museum"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
